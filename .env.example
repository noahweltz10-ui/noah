# Shopify Storefront API — required for real add-to-cart / checkout.
# Shopify Admin → Settings → Apps and sales channels → Develop apps →
# create/select an app → Configure Storefront API scopes → install →
# reveal the Storefront API access token (NOT the Admin API key).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Optional — enables the contact form to actually send an email via Resend
# (https://resend.com). Without these it just logs submissions server-side.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=

# Optional — enables the email capture form to actually subscribe via
# Klaviyo. Without these it just logs submissions server-side.
KLAVIYO_PRIVATE_KEY=
KLAVIYO_LIST_ID=

# Required for the owner dashboard (/dashboard) — Supabase project URL and
# publishable (anon) key. Safe to expose client-side; row-level security
# policies gate all real access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required only for inviting staff accounts (Supabase project settings →
# API → service_role key). Server-only, never exposed to the browser —
# do NOT prefix with NEXT_PUBLIC_. Treat as a master key for this project's
# database.
SUPABASE_SERVICE_ROLE_KEY=

# Required to sync the dashboard's orders/inventory/customers/discounts to
# the real Shopify store. Different from the Storefront token above — this
# is an Admin API access token from a custom app (Shopify admin → Settings
# → Apps and sales channels → Develop apps → create/select an app →
# configure Admin API scopes → install → reveal the Admin API access
# token). Treat this as highly sensitive: it can read customer PII and
# issue refunds. Without it, the dashboard runs on its own demo/override
# data instead of live store data.
SHOPIFY_ADMIN_API_TOKEN=

# Required for the mini-assistant widget on the dashboard. Get one at
# https://console.anthropic.com. Without it the assistant button is
# disabled with an explanatory message instead of faking a response.
ANTHROPIC_API_KEY=
